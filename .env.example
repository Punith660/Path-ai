# Path-ai Verify — Environment Configuration
# Copy this file to .env and fill in the values.
#   cp .env.example .env

# --- Required ---
# Generate a JWT secret key:
#   openssl rand -hex 32
JWT_SECRET_KEY=change_me_to_a_random_secret

# --- Database ---
# Default: SQLite for local development.
# For production, use PostgreSQL (Neon):
#   DATABASE_URL=postgresql://user:password@host:port/dbname
DATABASE_URL=sqlite:///pathai.db

# --- CORS ---
# Comma-separated list of allowed origins for CORS.
# Default: localhost development origins.
# Example:
#   CORS_ORIGINS=https://app.example.com,https://admin.example.com
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# --- Frontend URL ---
# Used for password reset links etc.
FRONTEND_URL=http://localhost:5173

# --- Environment ---
# Set to "production" to enable HTTPS enforcement (requires a TLS-terminating
# reverse proxy like nginx or Cloudflare).
ENVIRONMENT=development

# --- Allowed Hosts ---
# Comma-separated list of allowed Host header values for host header injection
# protection. In production, set to your domain(s).
# Example:
#   ALLOWED_HOSTS=app.example.com,api.example.com
ALLOWED_HOSTS=localhost,[IP_ADDRESS],pathai-resume-verification-tool.onrender.com


# --- JWT ---
# Token lifetime in minutes (default: 60).
JWT_EXPIRE_MINUTES=60

# --- Password Reset ---
# Reset token lifetime in minutes (default: 15).
RESET_TOKEN_EXPIRE_MINUTES=15

# --- Rate Limiting ---
MAX_LOGIN_ATTEMPTS=5
LOGIN_WINDOW_SECONDS=300
ACCOUNT_LOCKOUT_SECONDS=900
MAX_RESET_ATTEMPTS=3
RESET_WINDOW_SECONDS=3600

# --- Server ---
PORT=8000